DATABASE_URL="postgresql://user:password@host/db?sslmode=require"
NEXTAUTH_SECRET="generate-with-openssl-rand-base64-32"
NEXTAUTH_URL="http://localhost:3000"

# Gates the "internal" NextAuth Credentials provider (lib/auth.ts).
# Only /api/auth/verify ever sends this — it's what stops someone
# from POSTing straight to /api/auth/callback/credentials and minting
# a session for any email without ever receiving a magic link.
# Generate with: openssl rand -base64 32
INTERNAL_AUTH_SECRET="generate-a-second-long-random-secret"

# NOTE: the teacher registration code used to live here as
# TEACHER_SIGNUP_CODE. It's now admin-editable (Settings.teacherInviteCode,
# set from /dashboard/admin) so it no longer needs an env var or a
# redeploy to rotate.

# Used once by `npx prisma db seed` to create the first teacher
# account (Natia) without going through /register at all.
SEED_TEACHER_EMAIL="natia@example.com"
SEED_TEACHER_NAME="ნათია"

# Used once by `npx prisma db seed` to create the first admin
# account. identityEmail is what's typed on the shared login form;
# notificationEmail is the real inbox the magic-link mail is sent to
# (can be any address, doesn't need to be unique).
SEED_ADMIN_IDENTITY_EMAIL="lizozivzivadze123@gmail.com"
SEED_ADMIN_NOTIFICATION_EMAIL="lizozivzivadze@gmail.com"
SEED_ADMIN_NAME="Lizi"

# SMTP, for actually sending magic-link login emails. Any SMTP
# account works (Gmail app-password, Zoho, a transactional provider's
# SMTP endpoint, etc.) — nothing is locked to one vendor. If these
# four are left unset, the app falls back to logging the link to the
# server console instead of sending it (handy for local dev).
SMTP_HOST="smtp.example.com"
SMTP_PORT="587"
SMTP_USER="you@example.com"
SMTP_PASSWORD="your-smtp-password-or-app-password"
# Optional — defaults to SMTP_USER if omitted
SMTP_FROM="Tutor Platform <you@example.com>"
